PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/ecotrace
DATABASE_USER=ecotrace
DATABASE_PASSWORD=ecotrace
# JWT_SECRET and DATABASE_PASSWORD are required: the server refuses to start without them.
JWT_SECRET=change-me-in-production-use-long-random-string
CORS_ALLOWED_HOSTS=localhost:8080
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
